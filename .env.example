# PostgreSQL instance running directly on the Mac.
POSTGRES_DATABASE=factor_investing
POSTGRES_PORT=5432
POSTGRES_USER=tushardesarda
POSTGRES_PASSWORD=

# Optional LLM integrations
ICA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional ONE-TIME first-Superadmin bootstrap; remove after the account is persisted.
# All accounts/password hashes and the auto-generated JWT signing key live in the database.
AUTH_BOOTSTRAP_SUPERADMIN_EMAIL=
AUTH_BOOTSTRAP_SUPERADMIN_PASSWORD=
AUTH_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
